# Flask configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-placeholder

# Database configuration (MySQL connection string)
# Primary Database: MySQL (using PyMySQL driver)
# Format: mysql+pymysql://username:password@localhost:3306/db_name
DATABASE_URL=mysql+pymysql://your_mysql_username:your_mysql_password@localhost:3306/medical_db

# Mail configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@example.com

