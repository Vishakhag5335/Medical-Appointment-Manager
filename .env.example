# Flask configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-placeholder

# Database configuration (MySQL connection string)
# Primary Database: MySQL (using PyMySQL driver)
# Format: mysql+pymysql://username:password@localhost:3306/db_name
DATABASE_URL=mysql+pymysql://your_mysql_username:your_mysql_password@localhost:3306/medical_db

# Mail configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@example.com

# Development Seed Passwords (used when running 'flask seed-db')
# Replace placeholders in local .env - NEVER put real passwords in .env.example
SEED_ADMIN_PASSWORD=your_seed_admin_password_here
SEED_DOCTOR_PASSWORD=your_seed_doctor_password_here
SEED_PATIENT_PASSWORD=your_seed_patient_password_here
